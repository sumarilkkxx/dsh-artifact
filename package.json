{
  "name": "dsh-artifact",
  "version": "0.2.0",
  "description": "Render ECharts, Mermaid, Three.js, and sandboxed custom HTML inline in DeepSeek Harness conversations — declarative payloads fed to the real engines.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "echarts": "^5.5.1",
    "mermaid": "^11.16.1",
    "three": "^0.149.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
